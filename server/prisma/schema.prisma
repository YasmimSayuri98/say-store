generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CategoriaMaterial {
  id        Int        @id @default(autoincrement())
  nome      String     @unique
  materiais Material[]
}

model UnidadeMedida {
  id        Int        @id @default(autoincrement())
  nome      String     @unique
  sigla     String     @unique
  grandeza  String     // massa, volume, comprimento, contagem
  materiais Material[]
}

model Fornecedor {
  id        Int              @id @default(autoincrement())
  nome      String           @unique
  tipo      String           @default("FISICA")  // FISICA | ECOMMERCE
  ecommerce String?          // nome do ecommerce quando tipo = ECOMMERCE
  entradas  EntradaEstoque[]
}

model Material {
  id                Int      @id @default(autoincrement())
  nome              String
  categoriaId       Int
  unidadeId         Int
  quantidade        Float    @default(0)
  quantidadeMinima  Float    @default(0)
  custoMedio        Float    @default(0)
  observacoes       String?
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  categoria   CategoriaMaterial   @relation(fields: [categoriaId], references: [id])
  unidade     UnidadeMedida       @relation(fields: [unidadeId], references: [id])
  filamento   FilamentoDetalhe?
  entradas    EntradaEstoque[]
  movimentacoes MovimentacaoEstoque[]
  itensFicha  ItemFichaTecnica[]
  itensEmbalagem ItemEmbalagem[]
  ajustes     AjusteEstoque[]
  perdas      Perda[]
}

// Perda de material: gasto em teste de produto ou erro de produção. Desconta o material do estoque.
model Perda {
  id               Int      @id @default(autoincrement())
  tipo             String   // TESTE | ERRO_PRODUCAO
  produtoId        Int?     // quando a perda é de um produto cadastrado
  nomeProdutoTeste String?  // quando é um produto não cadastrado / teste
  materialId       Int
  quantidade       Float    // quantidade de material gasta (na unidade do material)
  custoTotal       Float    @default(0)  // snapshot: quantidade × custoMedio do material
  motivo           String?
  criadoEm         DateTime @default(now())

  produto  Produto?  @relation(fields: [produtoId], references: [id])
  material Material  @relation(fields: [materialId], references: [id])
}

model FilamentoDetalhe {
  id                Int      @id @default(autoincrement())
  materialId        Int      @unique
  tipo              String?
  marca             String?
  cor               String?
  pesoOriginalRolo  Float?
  pesoDisponivel    Float?
  observacoes       String?
  material          Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
}

model EntradaEstoque {
  id             Int      @id @default(autoincrement())
  materialId     Int
  quantidade     Float
  valorTotal     Float
  custoUnitario  Float
  custoMedioApos Float
  dataCompra     DateTime @default(now())
  fornecedorId   Int?
  observacao     String?
  criadoEm       DateTime @default(now())

  material   Material    @relation(fields: [materialId], references: [id])
  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id])
}

model Produto {
  id                  Int      @id @default(autoincrement())
  nome                String
  sku                 String   @unique
  descricao           String?
  ativo               Boolean  @default(true)
  personalizado       Boolean  @default(false)  // "Foto do pedido": recebe foto do cliente para impressão
  producaoEstendida   Boolean  @default(false)  // produção mais demorada (o "personalizado" da Shopee = prazo maior)
  estoque             Float    @default(0)  // unidades prontas em estoque (produto acabado)
  custoAtualMateriais Float    @default(0)
  custosExtras        Float    @default(0)  // energia, mão de obra, embalagem não rastreada, etc.
  margemLucroAlvo     Float    @default(0)  // margem de lucro alvo (%) para sugerir preço
  paginaGramas        Float    @default(0)  // álbuns (SKU LIV-FOT-PERS): gramas de filamento das páginas, descontadas ao marcar "páginas"
  // Dados fiscais (NF-e) — preencher com orientação do contador
  ncm               String?  // Nomenclatura Comum do Mercosul (8 dígitos)
  cfop              String?  // Código Fiscal de Operações (ex.: 5102)
  origemMercadoria  String   @default("0")   // 0 = nacional; ver tabela de origem
  csosn             String?  // Simples Nacional (ex.: 102, 500)
  cest              String?  // opcional, quando aplicável
  unidadeTributavel String   @default("UN")  // unidade comercial na nota
  ultimoCalculoCusto  DateTime?
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  itensFicha   ItemFichaTecnica[]
  itensEnvio   ItemRegistroEnvio[]
  precos       PrecoProduto[]
  itensPedidosPlataforma ItemPedidoPlataforma[]
  devolucoes   Devolucao[]
  perdas       Perda[]
}

// Devolução de produto que voltou ao vendedor. Se aptoEstoque, a quantidade volta ao estoque
// de produto pronto (Produto.estoque).
model Devolucao {
  id              Int      @id @default(autoincrement())
  produtoId       Int?
  quantidade      Float    @default(1)
  aptoEstoque     Boolean  @default(false)  // produto está apto a voltar ao estoque?
  retornouEstoque Boolean  @default(false)  // realmente somou ao estoque de produto pronto
  numeroPedido    String?  // pedido de origem (opcional)
  motivo          String?
  criadoEm        DateTime @default(now())

  produto Produto? @relation(fields: [produtoId], references: [id])
}

model PlataformaVenda {
  id                    Int      @id @default(autoincrement())
  nome                  String   @unique
  comissaoPercentual    Float    @default(0)  // % de comissão sobre o valor de venda
  taxaFixaPorItem       Float    @default(0)  // R$ fixos por unidade vendida
  percentualFreteGratis Float    @default(0)  // % adicional (programa de frete grátis)
  ativo                 Boolean  @default(true)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  precos      PrecoProduto[]
  envios      RegistroEnvio[]
  saques      SaquePlataforma[]
  integracao  IntegracaoPlataforma?
  pedidos     PedidoPlataforma[]
}

model PrecoProduto {
  id           Int   @id @default(autoincrement())
  produtoId    Int
  plataformaId Int
  precoVenda   Float @default(0)

  produto    Produto         @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  plataforma PlataformaVenda @relation(fields: [plataformaId], references: [id], onDelete: Cascade)
  @@unique([produtoId, plataformaId])
}

model ItemFichaTecnica {
  id                Int      @id @default(autoincrement())
  produtoId         Int
  materialId        Int
  quantidade        Float
  parte             String   @default("GERAL")  // GERAL | CAPA | PAGINA (álbuns dividem a ficha em capa/páginas)
  produto  Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])
  @@unique([produtoId, materialId, parte])
}

model RegistroEnvio {
  id                  Int      @id @default(autoincrement())
  dataEnvio           DateTime @default(now())
  observacao          String?
  numeroPedido        String?  @unique  // nº do pedido na plataforma (ex.: order_sn da Shopee); evita baixa duplicada
  custoTotalMateriais Float    @default(0)
  plataformaId        Int?
  faturamentoBruto    Float    @default(0)  // Σ preço de venda × quantidade
  totalTaxas          Float    @default(0)  // comissão + taxa fixa da plataforma
  custoTotalProdutos  Float    @default(0)  // custo final (materiais + extras) × quantidade
  custoEmbalagem      Float    @default(0)  // custo dos materiais de embalagem usados neste envio
  lucro               Float    @default(0)  // faturamento − taxas − custo dos produtos
  criadoEm            DateTime @default(now())

  plataforma             PlataformaVenda?       @relation(fields: [plataformaId], references: [id])
  itens                  ItemRegistroEnvio[]
  movimentacoes          MovimentacaoEstoque[]
  itensPedidosPlataforma ItemPedidoPlataforma[]
  usosEmbalagem          UsoEmbalagem[]
}

model ItemRegistroEnvio {
  id                 Int   @id @default(autoincrement())
  envioId            Int
  produtoId          Int
  quantidade         Float
  precoVendaUnitario Float @default(0)  // snapshot do preço de venda na plataforma
  custoUnitario      Float @default(0)  // snapshot do custo final unitário (materiais + extras)
  envio   RegistroEnvio @relation(fields: [envioId], references: [id], onDelete: Cascade)
  produto Produto       @relation(fields: [produtoId], references: [id])
}

model MovimentacaoEstoque {
  id                  Int      @id @default(autoincrement())
  materialId          Int
  tipo                String   // ENTRADA_COMPRA, SAIDA_ENVIO, SAIDA_EMBALAGEM, AJUSTE_POSITIVO, AJUSTE_NEGATIVO, CORRECAO, ESTORNO, SAIDA_PRODUCAO_PLATAFORMA, ENTRADA_ESTORNO_PRODUCAO_PLATAFORMA
  quantidadeAnterior  Float
  quantidadeMovimentada Float
  quantidadeResultante Float
  motivo              String?
  observacao          String?
  produtoId           Int?
  envioId             Int?
  itemPedidoPlataformaId Int?
  usoEmbalagemId      Int?
  criadoEm            DateTime @default(now())

  material             Material              @relation(fields: [materialId], references: [id])
  envio                RegistroEnvio?        @relation(fields: [envioId], references: [id])
  itemPedidoPlataforma ItemPedidoPlataforma? @relation(fields: [itemPedidoPlataformaId], references: [id])
  usoEmbalagem         UsoEmbalagem?         @relation(fields: [usoEmbalagemId], references: [id])
}

model AjusteEstoque {
  id         Int      @id @default(autoincrement())
  materialId Int
  tipo       String   // ADICIONAR, REMOVER, DEFINIR
  quantidade Float
  motivo     String
  observacao String?
  criadoEm   DateTime @default(now())
  material   Material @relation(fields: [materialId], references: [id])
}

// ---------- Módulo financeiro (fluxo de caixa) ----------

model ContaFinanceira {
  id           Int      @id @default(autoincrement())
  nome         String   @unique
  tipo         String   // CAIXA, BANCO, RESERVA_LUCRO, OUTRO
  saldoAtual   Float    @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  movimentacoes MovimentacaoFinanceira[]
  parcelas      ParcelaConta[]
  saquesDestino SaquePlataforma[] @relation("saqueDestino")
  saquesLucro   SaquePlataforma[] @relation("saqueLucro")
}

model MovimentacaoFinanceira {
  id        Int      @id @default(autoincrement())
  contaId   Int
  tipo      String   // ENTRADA, SAIDA
  origem    String   // SALDO_INICIAL, SAQUE_PLATAFORMA, DIRECIONAMENTO_LUCRO, PAGAMENTO_CONTA, APORTE, AJUSTE, TRANSFERENCIA
  valor     Float
  descricao String?
  saldoApos Float
  data      DateTime @default(now())
  saqueId   Int?
  parcelaId Int?
  criadoEm  DateTime @default(now())

  conta ContaFinanceira @relation(fields: [contaId], references: [id])
}

model SaquePlataforma {
  id              Int      @id @default(autoincrement())
  plataformaId    Int?
  contaDestinoId  Int
  contaLucroId    Int?
  valorBruto      Float
  percentualLucro Float    @default(0)
  valorLucro      Float    @default(0)
  valorLiquido    Float    @default(0)
  data            DateTime @default(now())
  observacao      String?
  criadoEm        DateTime @default(now())

  plataforma   PlataformaVenda? @relation(fields: [plataformaId], references: [id])
  contaDestino ContaFinanceira  @relation("saqueDestino", fields: [contaDestinoId], references: [id])
  contaLucro   ContaFinanceira? @relation("saqueLucro", fields: [contaLucroId], references: [id])
}

model ContaPagar {
  id             Int      @id @default(autoincrement())
  descricao      String
  categoria      String?
  formaPagamento String?  // em qual cartão/boleto a compra foi parcelada
  fixa           Boolean  @default(false)  // conta fixa: repete todo mês (valorTotal = valor mensal) até cancelar
  valorTotal     Float
  numeroParcelas Int      @default(1)
  observacao     String?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  parcelas ParcelaConta[]
}

model ParcelaConta {
  id                Int       @id @default(autoincrement())
  contaPagarId      Int
  numero            Int
  valor             Float
  vencimento        DateTime
  pago              Boolean   @default(false)
  dataPagamento     DateTime?
  contaFinanceiraId Int?
  criadoEm          DateTime  @default(now())

  contaPagar      ContaPagar       @relation(fields: [contaPagarId], references: [id], onDelete: Cascade)
  contaFinanceira ContaFinanceira? @relation(fields: [contaFinanceiraId], references: [id])
}

// Bloco de notas/afazeres do Dashboard (registro único).
model Nota {
  id           Int      @id @default(1)
  texto        String   @default("")
  atualizadoEm DateTime @updatedAt
}

// Afazeres do Dashboard em formato de checklist.
model Tarefa {
  id       Int      @id @default(autoincrement())
  texto    String
  feito    Boolean  @default(false)
  criadoEm DateTime @default(now())
}

model ConfiguracaoFinanceira {
  id                       Int      @id @default(1)
  percentualLucroPadrao    Float    @default(0)
  contaLucroPadraoId       Int?
  contaOperacionalPadraoId Int?
  atualizadoEm             DateTime @updatedAt
}

// ---------- Integração com plataformas (pedidos -> lista de produção) ----------
// Genérico por plataforma (Shopee, TikTok Shop, ...): cada PlataformaVenda pode ter uma
// IntegracaoPlataforma (credenciais de API) e pedidos sincronizados via PedidoPlataforma.

model IntegracaoPlataforma {
  plataformaId        Int       @id  // 1:1 com PlataformaVenda
  tipo                String              // 'SHOPEE' | 'TIKTOK'
  appId               String?             // Shopee: partner_id · TikTok: app_key
  appSecret           String?             // Shopee: partner_key · TikTok: app_secret
  lojaId              String?             // Shopee: shop_id · TikTok: shop_cipher
  accessToken         String?
  refreshToken        String?
  accessTokenExpiraEm DateTime?
  ultimaSincronizacao DateTime?
  ativo               Boolean   @default(false)
  atualizadoEm        DateTime  @updatedAt

  plataforma PlataformaVenda @relation(fields: [plataformaId], references: [id])
}

model PedidoPlataforma {
  id           Int       @id @default(autoincrement())
  plataformaId Int
  numeroPedido String    @unique  // order_sn (Shopee) / order_id (TikTok); trava duplicidade
  status       String
  prazoEnvio   DateTime?
  dataPedido   DateTime?
  observacao   String?   // anotações do pedido (ex.: cadastro manual), exibidas na lista de produção
  // Pipeline do Dashboard: Emissão de nota -> Programação de envio (etiqueta) -> Produção
  notaEmitida      Boolean   @default(false)
  notaEmitidaEm    DateTime?
  etiquetaGerada   Boolean   @default(false)
  etiquetaGeradaEm DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  plataforma PlataformaVenda        @relation(fields: [plataformaId], references: [id])
  itens      ItemPedidoPlataforma[]
  usosEmbalagem UsoEmbalagem[]
}

model ItemPedidoPlataforma {
  id             Int       @id @default(autoincrement())
  pedidoId       Int
  produtoId      Int?
  envioId        Int?      // preenchido quando este item foi coberto por um envio manual (ver RegistroEnvio.numeroPedido)
  skuPlataforma  String
  nomePlataforma String
  quantidade     Float
  produzido      Boolean   @default(false)
  produzidoEm    DateTime?
  produzidoDoEstoque Boolean? // true = "produzido" consumiu do estoque de produto pronto; false = descontou material
  finalizado     Boolean   @default(false)  // etapa: acabamento/finalização concluída (entre produzido e embalado)
  finalizadoEm   DateTime?
  fotoImpressa   Boolean   @default(false)  // impressão da foto do cliente concluída (produtos personalizados) — mantido em sincronia com fotoStatus
  fotoImpressaEm DateTime?
  fotoStatus     String?   // 'IMPRESSA' | 'SEM_FOTO' | 'CLIENTE_NAO_ENVIOU' (produtos com foto do cliente)
  etiquetaImpressa   Boolean   @default(false)  // etiqueta de envio impressa (não desconta estoque; a etiqueta é baixada na embalagem)
  etiquetaImpressaEm DateTime?
  capaFeita      Boolean   @default(false)  // álbum: capa (cor do SKU) produzida — check visual, não desconta estoque
  capaFeitaEm    DateTime?
  paginasFeitas  Boolean   @default(false)  // álbum: páginas produzidas (desconta filamento escolhido)
  paginasFeitasEm DateTime?
  paginaFilamentoId Int?    // álbum: material (filamento) usado nas páginas
  embalado       Boolean   @default(false)  // etapa: pedido embalado (pronto para enviar)
  embaladoEm     DateTime?
  enviado        Boolean   @default(false)  // etapa final: produto já enviado ao cliente
  enviadoEm      DateTime?
  criadoEm       DateTime  @default(now())

  pedido        PedidoPlataforma      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto       Produto?              @relation(fields: [produtoId], references: [id])
  envio         RegistroEnvio?        @relation(fields: [envioId], references: [id])
  movimentacoes MovimentacaoEstoque[]

  @@unique([pedidoId, skuPlataforma])
}

// ---------- Embalagem de envio ----------
// Tipo de embalagem = um "kit" de materiais (caixa, fita, plástico bolha, etiqueta...) com
// quantidades. Na hora do envio a pessoa escolhe qual embalagem usou; o consumo é baixado do
// estoque (UsoEmbalagem). NÃO entra no custo/preço do produto — é controle separado.

model Embalagem {
  id           Int             @id @default(autoincrement())
  nome         String          @unique
  ativo        Boolean         @default(true)
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  itens ItemEmbalagem[]
  usos  UsoEmbalagem[]
}

model ItemEmbalagem {
  id          Int   @id @default(autoincrement())
  embalagemId Int
  materialId  Int
  quantidade  Float

  embalagem Embalagem @relation(fields: [embalagemId], references: [id], onDelete: Cascade)
  material  Material  @relation(fields: [materialId], references: [id])

  @@unique([embalagemId, materialId])
}

// Registro de uma embalagem efetivamente usada num envio (quantos pacotes daquele tipo).
// Pode estar vinculado a um RegistroEnvio (tela Registrar envio) ou a um PedidoPlataforma
// (marcar "enviado" no Dashboard). custoTotal é um snapshot para os relatórios de envio.
model UsoEmbalagem {
  id          Int      @id @default(autoincrement())
  embalagemId Int
  quantidade  Float    @default(1)
  custoTotal  Float    @default(0)
  data        DateTime @default(now())
  envioId     Int?
  pedidoId    Int?
  criadoEm    DateTime @default(now())

  embalagem     Embalagem             @relation(fields: [embalagemId], references: [id])
  envio         RegistroEnvio?        @relation(fields: [envioId], references: [id])
  pedido        PedidoPlataforma?     @relation(fields: [pedidoId], references: [id])
  movimentacoes MovimentacaoEstoque[]
}
