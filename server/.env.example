# Caminho do banco SQLite.
# Local: file:./dev.db  |  Railway (volume em /data): file:/data/prod.db
DATABASE_URL="file:./dev.db"

# Porta da API (o Railway define automaticamente; localmente use 3001)
PORT=3001

# Senha única de acesso ao sistema (defina uma senha forte em produção)
APP_PASSWORD="troque-esta-senha"

# Segredo para assinar os tokens de login (use um texto longo e aleatório em produção)
AUTH_SECRET="troque-por-um-texto-longo-e-aleatorio"

# Origem permitida para o front-end. Em produção, coloque a URL do site no Vercel
# (ex.: https://say-store.vercel.app). Deixe vazio para liberar geral (local).
CORS_ORIGIN=""
